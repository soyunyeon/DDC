import argparse
import json
import random
from pathlib import Path

import torch
from torch.utils.data import Dataset

from transformers import (
    AutoTokenizer,
    Trainer,
    TrainingArguments,
)

from m4_model import SymptomSeq2Seq


ROOT = Path(__file__).resolve().parents[1]

MODELS = {
    "kobart": "gogamza/kobart-base-v2",
    "t5": "KETI-NLP/ke-t5-base",
}


class PrefixDataset(Dataset):
    def __init__(self, path, limit=0):
        self.rows = []

        with open(path, encoding="utf-8") as f:
            for line in f:
                self.rows.append(json.loads(line))

                if limit > 0 and len(self.rows) >= limit:
                    break

        print(
            f"Dataset: {len(self.rows):,} prefixes",
            flush=True
        )

    def __len__(self):
        return len(self.rows)

    def __getitem__(self, idx):
        return self.rows[idx]


class Seq2SeqCollator:
    def __init__(self, tokenizer, max_input=384):
        self.tokenizer = tokenizer
        self.max_input = max_input

    def __call__(self, batch):
        texts = [x["input_text"] for x in batch]
        targets = [x["target_text"] for x in batch]

        enc = self.tokenizer(
            texts,
            padding=True,
            truncation=True,
            max_length=self.max_input,
            return_tensors="pt",
        )

        dec = self.tokenizer(
            text_target=targets,
            padding=True,
            truncation=True,
            max_length=48,
            return_tensors="pt",
        )

        labels = dec["input_ids"].clone()
        labels[
            labels == self.tokenizer.pad_token_id
        ] = -100

        multilabel = torch.tensor(
            [x["target_vector"] for x in batch],
            dtype=torch.float32,
        )

        enc["labels"] = labels
        enc["multilabel"] = multilabel

        return enc


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--model",
        choices=["kobart", "t5"],
        required=True
    )
    parser.add_argument(
        "--experiment",
        default="baseline_v1"
    )
    parser.add_argument(
        "--epochs",
        type=float,
        default=3
    )
    parser.add_argument(
        "--batch",
        type=int,
        default=1
    )
    parser.add_argument(
        "--accum",
        type=int,
        default=8
    )
    parser.add_argument(
        "--lr",
        type=float,
        default=3e-5
    )
    parser.add_argument(
        "--max_input",
        type=int,
        default=384
    )
    parser.add_argument(
        "--max_steps",
        type=int,
        default=-1
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=0
    )

    args = parser.parse_args()

    torch.manual_seed(42)
    random.seed(42)

    model_name = MODELS[args.model]

    output_dir = (
        ROOT / "Checkpoints"
        / args.model
        / args.experiment
    )

    output_dir.mkdir(parents=True, exist_ok=True)

    tokenizer = AutoTokenizer.from_pretrained(
        model_name
    )

    # 긴 대화에서는 현재 시점의 최신 문맥 우선
    tokenizer.truncation_side = "left"

    model = SymptomSeq2Seq(
        model_name=model_name
    )

    dataset = PrefixDataset(
        ROOT / "Work" / "Seq2Seq"
        / "train_prefix.jsonl",
        limit=args.limit
    )

    collator = Seq2SeqCollator(
        tokenizer,
        max_input=args.max_input
    )

    training_args = TrainingArguments(
        output_dir=str(output_dir / "trainer"),
        num_train_epochs=args.epochs,
        max_steps=args.max_steps,
        per_device_train_batch_size=args.batch,
        gradient_accumulation_steps=args.accum,
        learning_rate=args.lr,
        weight_decay=0.01,
        warmup_ratio=0.05,
        fp16=True,
        bf16=False,
        gradient_checkpointing=True,
        ddp_find_unused_parameters=False,
        max_grad_norm=1.0,
        logging_strategy="steps",
        logging_steps=20,
        save_strategy="epoch",
        save_total_limit=2,
        eval_strategy="no",
        report_to="none",
        dataloader_num_workers=2,
        remove_unused_columns=False,
        optim="adamw_torch",
        seed=42,
    )

    trainer = Trainer(
        model=model,
        args=training_args,
        train_dataset=dataset,
        data_collator=collator,
    )

    trainer.train()

    if trainer.is_world_process_zero():
        actual_model = (
            trainer.accelerator.unwrap_model(
                trainer.model
            )
        )

        torch.save(
            actual_model.state_dict(),
            output_dir / "model.pt"
        )

        actual_model.backbone.config.save_pretrained(
            output_dir
        )

        tokenizer.save_pretrained(output_dir)

        metadata = {
            "model": args.model,
            "base_model": model_name,
            "max_input": args.max_input,
            "epochs": args.epochs,
            "batch": args.batch,
            "accum": args.accum,
            "learning_rate": args.lr,
            "threshold": 0.5,
            "run": args.experiment,
        }

        with open(
            output_dir / "metadata.json",
            "w",
            encoding="utf-8"
        ) as f:
            json.dump(
                metadata,
                f,
                ensure_ascii=False,
                indent=2
            )

        print(
            f"학습 완료: {output_dir}",
            flush=True
        )


if __name__ == "__main__":
    main()
